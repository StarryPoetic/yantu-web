# Read server settings from a protected environment or start with node --env-file=.env server/start.ts.
# Never use VITE_ for secrets. Development and production must use separate databases.
YANTU_DATABASE_PATH=./var/yantu.sqlite
YANTU_SAMPLE_DATA=true
# Production requires NODE_ENV=production and an HTTPS origin; sample data is disabled.
# YANTU_ORIGIN=https://your-domain.example
# YANTU_ADMIN_CREDENTIALS=[{"actorId":"editor","token":"REPLACE_WITH_RANDOM_SECRET","roles":["editor"]},{"actorId":"reviewer","token":"REPLACE_WITH_ANOTHER_SECRET","roles":["reviewer"]},{"actorId":"publisher","token":"REPLACE_WITH_DISTINCT_SECRET","roles":["publisher","auditor"]}]
# Accounts: only first startup creates each administrator; never commit real credentials.
# Remove bootstrap passwords from runtime configuration after initialization.
# YANTU_BOOTSTRAP_ADMINS=[{"username":"editor","password":"REPLACE_WITH_UNIQUE_STRONG_PASSWORD","roles":["editor"]},{"username":"reviewer","password":"REPLACE_WITH_ANOTHER_STRONG_PASSWORD","roles":["reviewer","publisher","auditor"]}]
YANTU_AUTH_REGISTRATION_IP_LIMIT=10
YANTU_AUTH_LOGIN_IP_LIMIT=40
YANTU_MODEL_ENABLED=false
DEEPSEEK_API_KEY=
YANTU_MODEL_USER_DAILY_TOKENS=100000
YANTU_MODEL_DAILY_TOKENS=300000
# Research reports share the model budget. 100000 user tokens/day supports repeated profile comparisons within a bounded allowance.
YANTU_RESEARCH_MODEL=deepseek-v4-pro
YANTU_RESEARCH_EFFORT=high
YANTU_RESEARCH_TIMEOUT_MS=120000
YANTU_RESEARCH_MAX_OUTPUT_TOKENS=16384
YANTU_SEARCH_ENABLED=false
YANTU_SEARCH_PROVIDER=bocha
BOCHA_API_KEY=
# Brave is used only when YANTU_SEARCH_PROVIDER=brave; keys never fall back across providers.
BRAVE_SEARCH_API_KEY=
YANTU_SEARCH_USER_DAILY_REQUESTS=60
YANTU_SEARCH_DAILY_REQUESTS=300
# Opt in to fixed AliDNS HTTPS resolution only for DNS/Fake-IP compatibility. Private IPs stay blocked.
YANTU_DNS_MODE=system
# Exact HTTPS hostnames only; this replaces the built-in official-site allowlist.
# YANTU_OFFICIAL_HOSTS=yz.chsi.com.cn,yzb.pku.edu.cn
